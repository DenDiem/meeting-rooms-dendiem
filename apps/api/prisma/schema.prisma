generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(80)
  email           String   @db.VarChar(254)
  emailNormalized String   @unique @db.VarChar(254)
  passwordHash    String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  emailConfirmedAt DateTime? @db.Timestamptz(3)

  bookings      Booking[]
  sessions      Session[]
  confirmations EmailConfirmation[]
}

model EmailConfirmation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique @db.VarChar(80)
  floor    Int    @db.SmallInt
  capacity Int    @db.SmallInt

  bookings Booking[]
}

model Booking {
  id         String    @id @default(uuid()) @db.Uuid
  roomId     String    @db.Uuid
  userId     String    @db.Uuid
  title      String    @db.VarChar(100)
  startsAt   DateTime  @db.Timestamptz(3)
  endsAt     DateTime  @db.Timestamptz(3)
  canceledAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([roomId, startsAt])
  @@index([userId, startsAt])
}
