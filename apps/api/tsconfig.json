{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@database/*": ["./src/database/*"],
      "@generated/*": ["./src/generated/*"],
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "prisma.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts"
  ]
}
