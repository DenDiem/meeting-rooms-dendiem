{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@modules/*": ["./src/modules/*"],
      "@store/*": ["./src/store/*"],
      "@components/*": ["./src/_components/*"],
      "@domain/*": ["./src/_domain/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
